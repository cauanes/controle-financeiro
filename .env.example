# ==========================================
# Family Finance Hub - Environment Variables
# ==========================================

# Database Configurations
POSTGRES_PASSWORD=change-this-db-admin-password
APP_DB_PASSWORD=change-this-api-password
DATABASE_URL=postgresql://finance_app:change-this-api-password@localhost:5432/finance
MIGRATION_DATABASE_URL=postgresql://admin:change-this-db-admin-password@localhost:5432/finance

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Runtime Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
STORAGE_DIR=../.local/uploads

# WhatsApp Evolution API Integration
EVOLUTION_BASE_URL=http://localhost:8090
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_WEBHOOK_SECRET=your_webhook_secret_here

# Audio Transcription (Groq Whisper / OpenAI Whisper)
# Example for Groq: https://api.groq.com/openai/v1/audio/transcriptions
# Example for OpenAI: https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=your_transcription_api_key_here
TRANSCRIPTION_MODEL=whisper-large-v3
